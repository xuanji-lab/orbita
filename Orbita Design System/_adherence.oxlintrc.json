{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/composer/**",
              "components/core/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/orbita-desktop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Literata|Manrope|Source Han Serif SC|Source Han Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Literata, Manrope, Source Han Serif SC, Source Han Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssistantText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<AssistantText> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|badgeSize|mono|children|title|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, badgeSize, mono, children, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:secondary|outline|muted|accent|info)$/]",
        "message": "<Badge> variant must be one of 'secondary' | 'outline' | 'muted' | 'accent' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='badgeSize'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> badgeSize must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<BrandLockup> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|buttonSize|loading|disabled|onClick|children|style|title|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, buttonSize, loading, disabled, onClick, children, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger|ghost|accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'danger' | 'ghost' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='buttonSize'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> buttonSize must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|chevron|active|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: icon, chevron, active, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|placeholder|topSlot|bottomSlot|rows|disabled|running|style|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: value, onChange, onSubmit, placeholder, topSlot, bottomSlot, rows, disabled, running, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:layer|as|padding|radius|children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: layer, as, padding, radius, children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|base|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, base, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|buttonSize|active|disabled|onClick|children|title|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, variant, buttonSize, active, disabled, onClick, children, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline|soft)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outline' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='buttonSize'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<IconButton> buttonSize must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|size|children|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, title, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:full|medium|small)$/]",
        "message": "<Modal> size must be one of 'full' | 'medium' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|active|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<ModeChip> doesn't accept that prop. Declared props: icon, active, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|active|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<RailButton> doesn't accept that prop. Declared props: title, active, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RespondingIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|style|key|ref|className|style|children)$/]",
        "message": "<RespondingIndicator> doesn't accept that prop. Declared props: label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RespondingIndicator'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:running|waiting|error)$/]",
        "message": "<RespondingIndicator> tone must be one of 'running' | 'waiting' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectFieldOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|disabled|key|ref|className|style|children)$/]",
        "message": "<SelectFieldOption> doesn't accept that prop. Declared props: value, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|queries|running|loading|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SessionCard> doesn't accept that prop. Declared props: name, queries, running, loading, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|time|active|running|status|readOnly|onClick|onToggleReadOnly|style|key|ref|className|style|children)$/]",
        "message": "<SessionRow> doesn't accept that prop. Declared props: title, time, active, running, status, readOnly, onClick, onToggleReadOnly, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:running|done|failed|idle)$/]",
        "message": "<SessionRow> status must be one of 'running' | 'done' | 'failed' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|description|placeholder|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, description, placeholder, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|number|password)$/]",
        "message": "<TextField> type must be one of 'text' | 'number' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThinkingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|subtitle|duration|hint|detail|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<ThinkingCard> doesn't accept that prop. Declared props: label, subtitle, duration, hint, detail, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|subtitle|icon|tone|status|duration|detail|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<ToolCard> doesn't accept that prop. Declared props: name, subtitle, icon, tone, status, duration, detail, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:done|running|error)$/]",
        "message": "<ToolCard> tone must be one of 'done' | 'running' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UserBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|time|delivery|attachments|style|key|ref|className|style|children)$/]",
        "message": "<UserBubble> doesn't accept that prop. Declared props: children, time, delivery, attachments, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UserBubble'] > JSXAttribute[name.name='delivery'] > Literal[value!=/^(?:steer|follow-up)$/]",
        "message": "<UserBubble> delivery must be one of 'steer' | 'follow-up'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
