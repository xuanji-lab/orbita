{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // material-icon-theme 的 manifest（彩色文件图标的映射表，shell/FileTypeIcon.tsx）是 json
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // Node 原生执行 TS 时相对 import 必须带 .ts 后缀（它不做扩展名解析）
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/preload/**/*", "src/shared/**/*"]
}
