{
  "name": "orbita-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Orbita（璇玑）安卓端：配对到电脑，列任务、读尾部、回一句、停止",
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "start": "expo start --dev-client",
    "gen": "node scripts/gen-theme.ts && node scripts/gen-icons.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/*.test.ts\"",
    "prebuild": "expo prebuild --platform android --no-install",
    "apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "expo": "58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-crypto": "58.0.8",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.3",
    "typescript": "5.9.3"
  }
}
