+// [orbita patch] PDF / Word 指路：二进制文档按 UTF-8 读出来是乱码，改给模型一句「用哪个工具读」。
+// PDF 认文件头魔数（只读前 1024 字节，有流就只取头一块，不整读大文件）；Word 按扩展名——
+// PK 是通用 zip 魔数，按魔数会误指路 xlsx 等其它 office 包。
+const ORBITA_PDF_POINTER = "[This is a PDF document. Its binary content cannot be shown as text. Use the read_pdf tool to extract its text layer.]";
+const ORBITA_DOCX_POINTER = "[This is a Word document (.docx). Its binary content cannot be shown as text. Use the read_docx tool to read it as structured markdown.]";
+const ORBITA_DOC_POINTER = "[This is a legacy Word document (.doc). It is not supported directly — save it as .docx first, then use the read_docx tool.]";
+async function orbitaReadHead(ops, absolutePath, signal) {
+    if (!ops.createReadStream)
+        return (await ops.readFile(absolutePath)).subarray(0, 1024);
+    const chunks = [];
+    let size = 0;
+    for await (const chunk of ops.createReadStream(absolutePath, { signal })) {
+        chunks.push(Buffer.from(chunk));
+        size += chunk.length;
+        if (size >= 1024)
+            break;
+    }
+    return Buffer.concat(chunks).subarray(0, 1024);
+}
+async function orbitaBinaryDocumentPointer(ops, absolutePath, signal) {
+    if ((await orbitaReadHead(ops, absolutePath, signal)).toString("latin1").includes("%PDF-"))
+        return ORBITA_PDF_POINTER;
+    if (/\.docx$/i.test(absolutePath))
+        return ORBITA_DOCX_POINTER;
+    if (/\.doc$/i.test(absolutePath))
+        return ORBITA_DOC_POINTER;
+    return undefined;
+}
