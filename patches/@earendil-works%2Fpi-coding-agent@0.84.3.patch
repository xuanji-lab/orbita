+    [DllImport("kernel32.dll", SetLastError = true)]
+    public static extern IntPtr CreateToolhelp32Snapshot(uint flags, uint pid);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    public static extern bool Process32FirstW(IntPtr h, ref PROCESSENTRY32W e);
