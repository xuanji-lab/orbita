{
  "name": "orbita",
  "private": true,
  "version": "0.1.2",
  "description": "本地优先的 Electron AI 桌面 Agent —— 单 agent 重建分支",
  "license": "MIT",
  "packageManager": "bun@1.3.6",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\"",
    "ui:smoke": "bun scripts/ui-smoke.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "icon": "bash scripts/make-icon.sh",
    "icon:win": "node scripts/make-icon-win.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-client": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-protocol": "0.84.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/canvas": "1.0.9",
    "diff": "^9.0.0",
    "jszip": "3.10.2",
    "katex": "0.16.47",
    "mammoth": "1.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "^4.4.3",
    "undici": "8.9.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "26.16.1",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.84.3": "patches/@earendil-works%2Fpi-ai@0.84.3.patch",
    "@earendil-works/pi-coding-agent@0.84.3": "patches/@earendil-works%2Fpi-coding-agent@0.84.3.patch"
  },
  "build": {
    "appId": "com.orbita.desktop",
    "productName": "orbita",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "orbita uses the microphone for voice input: what you say is transcribed into the message box."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "orbita-${version}-win-x64-setup.${ext}"
    }
  }
}
