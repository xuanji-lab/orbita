{
  "name": "orbita",
  "private": true,
  "version": "0.1.15",
  "description": "本地优先的 Electron AI 桌面 Agent —— 单 agent 重建分支",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.6",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "ui:smoke": "bun scripts/ui-smoke.mjs",
    "dist": "node scripts/fetch-search-bins.mjs darwin arm64 && electron-vite build && node scripts/dist-mac.mjs",
    "dist:win": "node scripts/fetch-search-bins.mjs win32 x64 && electron-vite build && electron-builder --win --publish never",
    "icon": "bash scripts/make-icon.sh",
    "icon:win": "node scripts/make-icon-win.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-client": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-protocol": "0.84.3",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@napi-rs/canvas": "1.0.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "^9.0.0",
    "electron-updater": "6.8.9",
    "jszip": "3.10.2",
    "katex": "0.16.47",
    "mammoth": "1.13.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "^4.4.3",
    "undici": "8.9.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "26.16.1",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.84.3": "patches/@earendil-works%2Fpi-ai@0.84.3.patch",
    "@earendil-works/pi-coding-agent@0.84.3": "patches/@earendil-works%2Fpi-coding-agent@0.84.3.patch"
  },
  "build": {
    "appId": "com.orbita.desktop",
    "productName": "orbita",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "npmRebuild": false,
    "releaseInfo": {
      "releaseNotes": "[icon:download] 新：Windows 版能自己更新了——有新版本会告诉你，你点「下载」才下载，下完点「重启以安装」才装。\n[icon:history] 新：设置 › 通用 › 软件更新 里能看「历史版本」，点开就知道每一版改了什么。\n[icon:fold-vertical] 新：对话更好读了——agent 说的话都留在外面，只把中间的思考和工具调用收起来。\n[icon:eye] 新：浅色主题下，卡片和小标签的底色换成更清楚的冷灰。\n[icon:hard-drive] 一切都在你自己的电脑上：会话、配置、密钥都存在本机，不上传、不同步。\n[icon:shield-check] 三档权限：计划（只读）、手动（每步问你）、放行（直接干活），随时切换。\n[icon:git-fork] 从任意一问分出新会话；也能回退到某一问，连这期间改过的文件一起退回。\n[icon:file-diff] 每轮结束有改动卡片，右栏「审查」里能看每个文件改了什么、逐个撤销。\n[icon:bot] agent 能派子会话分头干活；子会话的模型、权限你都能直接改，也能叫停。\n[icon:folder] 右栏「文件」：浏览工作区，直接预览文本、图片和 PDF。\n[icon:square-terminal] 内置终端：agent 跑的命令你都看得见，随时可以接手。\n[icon:globe] 内置浏览器：agent 能替你查网页、点按钮，和你共享登录状态。\n[icon:paperclip] 输入框：拖进文件、文件夹、图片；划选对话里的一段当引用发出去；还能语音听写。\n[icon:blocks] Skills 与 MCP：agent 能自己建 skill、接 MCP 服务，按工作区开关。\n[icon:cpu] 模型：内置 DeepSeek、智谱、Claude、Kimi 等，也能接任意兼容接口；密钥加密存在本机。\n[icon:folder-sync] 迁移：把 Proma、Claude Code、Codex 等的会话、skills、MCP 一键搬过来。"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xuanji-lab",
        "repo": "orbita"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "build/bin/darwin-arm64",
          "to": "bin",
          "filter": [
            "rg",
            "fd"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "orbita uses the microphone for voice input: what you say is transcribed into the message box."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "extraResources": [
        {
          "from": "build/bin/win32-x64",
          "to": "bin",
          "filter": [
            "rg.exe",
            "fd.exe"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "orbita-${version}-win-x64-setup.${ext}"
    }
  }
}
