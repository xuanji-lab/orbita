{
  "name": "orbita",
  "private": true,
  "version": "0.1.16",
  "description": "本地优先的 Electron AI 桌面 Agent —— 单 agent 重建分支",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.6",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "ui:smoke": "bun scripts/ui-smoke.mjs",
    "dist": "node scripts/fetch-search-bins.mjs darwin arm64 && electron-vite build && node scripts/dist-mac.mjs",
    "dist:win": "node scripts/fetch-search-bins.mjs win32 x64 && electron-vite build && electron-builder --win --publish never",
    "icon": "bash scripts/make-icon.sh",
    "icon:win": "node scripts/make-icon-win.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-client": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-protocol": "0.84.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@napi-rs/canvas": "1.0.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "^9.0.0",
    "electron-updater": "6.8.9",
    "jszip": "3.10.2",
    "katex": "0.16.47",
    "mammoth": "1.13.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "^4.4.3",
    "undici": "8.9.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "26.16.1",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.84.3": "patches/@earendil-works%2Fpi-ai@0.84.3.patch",
    "@earendil-works/pi-coding-agent@0.84.3": "patches/@earendil-works%2Fpi-coding-agent@0.84.3.patch"
  },
  "build": {
    "appId": "com.orbita.desktop",
    "productName": "orbita",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "npmRebuild": false,
    "releaseInfo": {
      "releaseNotes": "[icon:panel-left] 新：顶部换成一整条工具栏——侧栏开关、新任务、会话标题和右栏的标题都收进窗口最上面那排胶囊里；Windows 上分成两行，最小化 / 最大化 / 关闭不再挤着别的按钮。\n[icon:zap] 新：专注模式。点左上角的闪电，选好时长和工作区就开始计时；左栏换成这个工作区的文件，改过的标 U / M，双击文件能在右边预览。\n[icon:orbit] 新：专注快到点时，左下角的小星云会把这段时间做了什么整理好，到点直接告诉你；提前结束时它也会问你要不要总结。\n[icon:panel-right] 新：右栏记得每个会话离开时开着哪个面板，切回来自动恢复。\n[icon:file-diff] 审查面板的改动只显示文件名（重名才补上一层目录），悬停能在访达里定位，右键能复制路径。\n[icon:quote] 摘抄太长被截断时，下面多了「展开 / 收起」，长段落能完整看。\n[icon:cpu] 选模型的卡片左栏都换成了厂商图标；自建的兼容网关显示接口协议的图标，Claude 登录用橙色的 Claude 标。\n[icon:square-terminal] 终端：滚动条变细了，和别处一样；agent 打开终端时不再抢走你正在输入框里打的字。\n[icon:book-open] 修复：点过 PDF 引用后，「打不开」的红字不再跟到别的会话里。\n[icon:plug] 修复：OpenCode Go 上的 DeepSeek 模型不再时不时报 400；每个会话单独发会话标识，缓存命中更好。"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xuanji-lab",
        "repo": "orbita"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "build/bin/darwin-arm64",
          "to": "bin",
          "filter": [
            "rg",
            "fd"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "orbita uses the microphone for voice input: what you say is transcribed into the message box."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "extraResources": [
        {
          "from": "build/bin/win32-x64",
          "to": "bin",
          "filter": [
            "rg.exe",
            "fd.exe"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "orbita-${version}-win-x64-setup.${ext}"
    }
  }
}
