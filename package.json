{
  "name": "orbita",
  "private": true,
  "version": "0.1.16",
  "description": "本地优先的 Electron AI 桌面 Agent —— 单 agent 重建分支",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.6",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "ui:smoke": "bun scripts/ui-smoke.mjs",
    "dist": "node scripts/fetch-search-bins.mjs darwin arm64 && electron-vite build && node scripts/dist-mac.mjs",
    "dist:win": "node scripts/fetch-search-bins.mjs win32 x64 && electron-vite build && electron-builder --win --publish never",
    "icon": "bash scripts/make-icon.sh",
    "icon:win": "node scripts/make-icon-win.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-client": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-protocol": "0.84.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@napi-rs/canvas": "1.0.9",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff": "^9.0.0",
    "electron-updater": "6.8.9",
    "jszip": "3.10.2",
    "katex": "0.16.47",
    "mammoth": "1.13.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.1.200",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "shiki": "^4.4.3",
    "undici": "8.9.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "26.16.1",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.84.3": "patches/@earendil-works%2Fpi-ai@0.84.3.patch",
    "@earendil-works/pi-coding-agent@0.84.3": "patches/@earendil-works%2Fpi-coding-agent@0.84.3.patch"
  },
  "build": {
    "appId": "com.orbita.desktop",
    "productName": "orbita",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "npmRebuild": false,
    "releaseInfo": {
      "releaseNotes": "[icon:zap] 新：专注模式上线！点左上角的闪电，拨一下滚轮定好时长，左栏立刻只剩这个工作区的文件——谁改过一目了然（U 新增、M 修改），双击就能预览。其它会话跑完也不吵你，只悄悄记个未读。\n[icon:orbit] 新：左下角的小星云学会收工汇报了。快到点时它先替你复盘这段时间都干了啥，时间一到直接递上一张总结卡；想提前收工，它还会问一句「要不要总结一下？」\n[icon:panel-left] 新：顶部换成一整条 Safari 风工具栏，侧栏开关、新任务、会话标题、右栏标题齐刷刷排成一排胶囊；窗口再窄也不打架。Windows 上分成两行，最小化 / 关闭终于有了自己的地盘。\n[icon:square-terminal] 你打字，agent 跑命令，从此井水不犯河水——agent 开终端再也不会抢走你输入框里的光标；终端滚动条也瘦身成和别处一样的细条。\n[icon:panel-right] 新：右栏有记性了。每个会话离开时开着哪个面板，切回来原样等着你。\n[icon:cpu] 选模型的卡片换上了一排厂商小图标，扫一眼就认得；自建网关显示它说的是哪家协议，Claude 登录换上专属的橙色标。\n[icon:quote] 长摘抄不再只露三行：被截断时点「展开」，整段都在。\n[icon:file-diff] 审查面板更清爽：只显示文件名（重名才补一层目录），悬停直达所在文件夹，右键一键复制路径。\n[icon:plug] 修复：OpenCode Go 上的 DeepSeek 不再时不时甩来 400；每个会话单独报到，缓存命中更高、回得更快。\n[icon:book-open] 修复：点过一次 PDF 引用后，「打不开」的红字再也不会一路跟着你串到别的会话。\n[icon:panel-left] 修复：窗口变窄时右栏不再盖住工具栏，最小化 / 最大化 / 关闭都能点到；设置页顶部的胶囊标题不再消失。\n[icon:folder] 修复：专注结束后，失去权限的预览标签会自动收起，不再报「不是这条会话允许的根目录之一」。"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xuanji-lab",
        "repo": "orbita"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "build/bin/darwin-arm64",
          "to": "bin",
          "filter": [
            "rg",
            "fd"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "orbita uses the microphone for voice input: what you say is transcribed into the message box."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "extraResources": [
        {
          "from": "build/bin/win32-x64",
          "to": "bin",
          "filter": [
            "rg.exe",
            "fd.exe"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "orbita-${version}-win-x64-setup.${ext}"
    }
  }
}
